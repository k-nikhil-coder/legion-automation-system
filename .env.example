# Legion Automation System - Environment Variables Template
# Copy this file to .env and fill in your values.

# Telegram Bot Credentials (optional - pipeline falls back to PENDING_DRAFTS.md)
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Admin / Channel / Group chat ID where approval prompts are sent
# Send a message to @userinfobot or check updates to find your Telegram Chat ID
TELEGRAM_CHAT_ID=1234567890

# Database & Storage Paths (defaults to workspace directory)
# DB_PATH=legion.db
# PENDING_DRAFTS_PATH=PENDING_DRAFTS.md

# Network & Collector Settings
HTTP_TIMEOUT=12
MAX_ITEMS_PER_FEED=10
AUTO_UPDATE_INTERVAL_MINUTES=30
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36 LegionCommunityBot/1.0

# Optional Dashboard Moderation Auth & Local AI Summarization
# ADMIN_API_KEY=
USE_OLLAMA=0
